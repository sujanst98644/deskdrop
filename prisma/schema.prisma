generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum ListingStatus {
  AVAILABLE
  SOLD
}

enum OrderStatus {
  PENDING
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum Condition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions     Session[]
  accounts     Account[]
  listings     Listing[]
  buyerOrders  Order[]   @relation("BuyerOrders")
  sellerOrders Order[]   @relation("SellerOrders")

  buyerConversations  Conversation[] @relation("BuyerConversations")
  sellerConversations Conversation[] @relation("SellerConversations")
  sentMessages        Message[]

  @@map("users")
}

// --- Better Auth tables ---------------------------------------------------
// Credentials live on Account (hashed by Better Auth), never on User.

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  issuer                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// --- Marketplace ----------------------------------------------------------

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  listings Listing[]

  @@map("categories")
}

model Listing {
  id          String        @id @default(cuid())
  sellerId    String
  seller      User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title       String
  description String
  pricePaisa  Int // store Rs * 100
  condition   Condition
  images      String[]      @default([])
  status      ListingStatus @default(AVAILABLE)
  campusCity  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  orders        Order[]
  conversations Conversation[]

  @@index([status])
  @@index([categoryId])
  @@map("listings")
}

model Order {
  id        String      @id @default(cuid())
  listingId String
  listing   Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User        @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    User        @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Cascade)
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([buyerId])
  @@index([sellerId])
  @@map("orders")
}

// --- Messaging ------------------------------------------------------------
// A thread is scoped to one listing and one buyer: buying two things from the
// same seller gives two threads, not one confusing one.

model Conversation {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User     @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    User     @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)

  // Per-participant read marks — cheaper than a read flag on every message.
  buyerLastReadAt  DateTime?
  sellerLastReadAt DateTime?

  // Denormalised from the read marks so the header badge is a single indexed
  // COUNT instead of loading every conversation to compare timestamps in JS.
  buyerUnread  Boolean @default(false)
  sellerUnread Boolean @default(false)

  // Denormalised from the latest message so the unread badge in the header is
  // one flat query with no joins, on every page render.
  lastMessageAt DateTime?
  lastSenderId  String?

  messages  Message[]
  createdAt DateTime @default(now())
  // Bumped on every send so the inbox can order by recent activity.
  updatedAt DateTime @updatedAt

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([lastMessageAt])
  @@index([buyerId, buyerUnread])
  @@index([sellerId, sellerUnread])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}
