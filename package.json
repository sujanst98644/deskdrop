{
  "name": "deskdrop",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:generate": "bun --filter @deskdrop/db generate",
    "db:push": "bun --filter @deskdrop/db push",
    "db:studio": "bun --filter @deskdrop/db studio",
    "seed": "bun --filter @deskdrop/db seed"
  },
  "devDependencies": {
    "turbo": "^2.2.3",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  }
}